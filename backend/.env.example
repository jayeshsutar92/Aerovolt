# Aerovolt Backend Environment Configuration Template
# Copy this file to .env and customize as needed for local development.

# Application configuration
APP_NAME=Aerovolt
ENVIRONMENT=development
VERSION=0.1.0
DEBUG=false

# API Prefix
API_PREFIX=/api

# Allowed CORS origins (comma-separated or JSON array)
# Wildcards ('*') are disallowed when ENVIRONMENT=production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://aerovolt-alpha.vercel.app

# Elexon BMRS API Configuration
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_TIMEOUT_SECONDS=15.0
